# Instellingen van de agent (tools/discogs-agent.mjs). Kopieer dit bestand naar agent.env en vul in.
# agent.env staat in .gitignore. Een regel die al als omgevingsvariabele bestaat, gaat voor.

# Verplicht: het adres van je eigen app (zie docs/APP.md), zonder / aan het eind.
VINYLHUNTER_URL=https://vinylhunter.jouw-naam.workers.dev

# Sleutels. Hier invullen, of elk in een eigen bestand in de projectmap (token.env.txt, agent-key.txt,
# claude-token.env.txt, apify-token.txt). agent.env en die bestanden staan in .gitignore.
DISCOGS_TOKEN=
# Dezelfde waarde als de Worker-secret AGENT_KEY (npm run setup maakt hem voor je aan).
AGENT_KEY=
# Alleen voor de Marktplaats-scan (tools/marktplaats-scan.mjs):
APIFY_TOKEN=
ANTHROPIC_API_KEY=

# --- Claude via je eigen abonnement (route "abonnement" in de app) ---
# Pad naar het programma claude (Claude Code). Leeg = "claude" uit het PATH. Nodig als de agent als
# Windows-dienst draait of als claude via npm is geïnstalleerd (dan ...\npm\claude.cmd werkt niet: gebruik
# het pad naar claude.exe of cli.js van de native installatie).
CLAUDE_BIN=
# Hoeveel klussen tegelijk via het abonnement (0 = abonnementsroute uit).
CLAUDE_PARALLEL=3

# --- Lokaal model (route "lokaal" in de app), alleen voor herkenning van vinyl en Pokémon ---
# Elke server met de OpenAI-chat-API en afbeeldingen. Voorbeelden:
#   Ollama:    LOCAL_LLM_URL=http://localhost:11434/v1   LOCAL_LLM_MODEL=gemma3:27b
#   LM Studio: LOCAL_LLM_URL=http://localhost:1234/v1    LOCAL_LLM_MODEL=<naam zoals in LM Studio>
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
# Alleen als je server een sleutel vraagt:
LOCAL_LLM_KEY=
# Hoeveel foto's tegelijk naar het lokale model (1 is meestal het snelst op één GPU).
LOCAL_PARALLEL=1

# --- Voor testen ---
# AGENT_ZONDER_DISCOGS=1   alleen herkenning doen, geen Discogs
# AGENT_LOG=agent-test.log  ander logbestand
